---
/**
 * Document shell: <head> metadata (SEO, per-page hreflang, Open Graph), global
 * styles, fonts and the skip link. Visible content is passed in as a slot.
 */
import '@fontsource-variable/archivo';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import { languages, t, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import { site } from '../data/site';
import CursorDot from '../components/CursorDot.astro';

interface Props {
  lang: Lang;
  /** Locale-relative path of this page ('' | 'info/' | 'projects/<slug>/'). */
  path?: string;
  title?: string;
  description?: string;
  /** Site-relative Open Graph image; defaults to the shared card. */
  ogImage?: string;
  /** Page-specific JSON-LD (e.g. a project's CreativeWork). */
  schema?: Record<string, unknown>;
}

const { lang, path = '', title, description, ogImage, schema } = Astro.props;

const pageTitle = title ?? `${site.name} — ${site.role[lang]}`;
const pageDescription = description ?? t(lang, 'meta_description');

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale: Record<Lang, string> = { en: 'en_US', ca: 'ca_ES', es: 'es_ES' };
const ogImageUrl = new URL(ogImage ?? '/og/default.png', Astro.site);

/** The author, stated once on every page for search engines. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role[lang],
  email: `mailto:${site.email}`,
  url: Astro.site?.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Marks the document before first paint: the motion layer in global.css
         (image fades, scroll reveals) only ever hides content behind html.js,
         so a visitor without JS gets the page plainly visible. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Native view transitions (prod only: the dev-only layout editor needs
         full page loads, and transitions are best previewed with `npm run preview`). -->
    {import.meta.env.PROD && <ClientRouter />}

    <!-- The same page in the other languages. -->
    {
      languages.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), Astro.site)} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      languages
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)
    }
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>

  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <slot />
    <CursorDot />

    <script>
      // The quiet motion layer: mark lazy images as they finish decoding and
      // reveal canvas drawings as they scroll into view. Re-armed after every
      // ClientRouter navigation; everything degrades to "just visible".
      const arm = () => {
        document.querySelectorAll<HTMLImageElement>("img[loading='lazy']").forEach((img) => {
          const done = () => img.classList.add('is-loaded');
          if (img.complete) done();
          else {
            img.addEventListener('load', done, { once: true });
            img.addEventListener('error', done, { once: true });
          }
        });

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-inview');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        document.querySelectorAll('[data-reveal]:not(.is-inview)').forEach((el) => io.observe(el));
      };

      // Every ClientRouter swap strips <html> down to the attributes the
      // incoming static document carries, so the `js` mark set in <head> is
      // lost — and with it the whole motion layer, silently, from the first
      // in-site navigation onwards. Re-mark on after-swap: that runs with the
      // new DOM in place but before it is painted, so nothing flashes.
      const mark = () => document.documentElement.classList.add('js');

      arm();
      document.addEventListener('astro:after-swap', mark);
      document.addEventListener('astro:page-load', arm);
    </script>
  </body>
</html>
