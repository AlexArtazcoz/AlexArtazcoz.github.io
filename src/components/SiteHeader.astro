---
/**
 * Minimal header in the manner of the reference sites: the name set small in
 * caps on the left; "work / info" and the language switch on the right.
 * Static (not sticky) — the references let the page scroll clean.
 */
import { t, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import { site } from '../data/site';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  /** Locale-relative path of the current page (for the language switch). */
  path?: string;
  /** Which nav item is current: 'projects' | 'info' | none. */
  active?: 'projects' | 'info';
}

const { lang, path = '', active } = Astro.props;
---

<header class="hd container" transition:name="site-header" transition:animate="none">
  <a class="hd__name" href={localePath(lang, '')}>{site.name}</a>

  <nav class="hd__nav" aria-label="Site">
    <a href={localePath(lang, '')} aria-current={active === 'projects' ? 'page' : undefined}>
      {t(lang, 'nav_projects')}
    </a>
    <a href={localePath(lang, 'info/')} aria-current={active === 'info' ? 'page' : undefined}>
      {t(lang, 'nav_info')}
    </a>
  </nav>

  <LanguageSwitcher lang={lang} path={path} />
</header>

<style>
  /* One quiet line: name, sections, languages. On phones the gaps close up
     (and the switcher goes down to two-letter codes) so that line survives
     instead of dropping the languages onto an orphan row under the name. */
  .hd {
    display: flex;
    align-items: baseline;
    gap: 1.25rem 0.85rem;
    flex-wrap: wrap;
    /* Only bites on the line that has no auto margin: if a very narrow screen
       (or a large system font) still forces a wrap, the switcher lands in the
       right corner instead of orphaned under the wordmark. */
    justify-content: flex-end;
    padding-block: 1.4rem 2.8rem;
  }

  .hd__name {
    font-size: var(--fs-s);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hd__nav {
    display: flex;
    gap: 0.9rem;
    font-size: var(--fs-s);
    margin-inline-end: auto;
  }

  @media (min-width: 40rem) {
    .hd {
      column-gap: 2rem;
    }

    .hd__nav {
      gap: 1.25rem;
    }
  }

  .hd__nav a {
    color: var(--grey);
  }

  .hd__nav a:hover {
    color: var(--ink);
    opacity: 1;
  }

  .hd__nav a[aria-current='page'] {
    color: var(--ink);
  }
</style>
