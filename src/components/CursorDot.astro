---
/**
 * A small black dot that trails the mouse with a pronounced lag — the site's
 * quiet companion while moving around (after claygarden.jp). The works name
 * themselves inside their own images on hover; the dot stays wordless.
 *
 * Purely aesthetic: pointer-events none, hidden on touch screens, never
 * created for visitors who prefer reduced motion, and the native cursor is
 * left untouched.
 */
---

<div class="cur" data-cursor aria-hidden="true">
  <span class="cur__dot"></span>
</div>

<style>
  .cur {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 1200;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .cur.is-on {
    opacity: 1;
  }

  .cur__dot {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    transform: translate(-50%, -50%);
  }

  @media (hover: none), (pointer: coarse) {
    .cur {
      display: none;
    }
  }
</style>

<script>
  // Bound once per browser session; survives ClientRouter navigations because
  // the listeners live on document and re-find the node each pass.
  if (
    !(window as any).__aaCursorDot &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    (window as any).__aaCursorDot = true;

    let targetX = innerWidth / 2;
    let targetY = innerHeight / 2;
    let x = targetX;
    let y = targetY;
    let seen = false;

    const el = () => document.querySelector<HTMLElement>('[data-cursor]');

    document.addEventListener('mousemove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;
      if (!seen) {
        // First contact: appear where the mouse is, no dash across the screen.
        seen = true;
        x = targetX;
        y = targetY;
      }
      el()?.classList.add('is-on');
    });

    document.addEventListener('mouseleave', () => el()?.classList.remove('is-on'));

    const trail = () => {
      // Pronounced lag: the dot clearly drifts behind, arriving late on purpose.
      x += (targetX - x) * 0.07;
      y += (targetY - y) * 0.07;
      const cur = el();
      if (cur) cur.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      requestAnimationFrame(trail);
    };
    requestAnimationFrame(trail);
  }
</script>
