---
/**
 * A project's own page, in the manner of the reference sites: small title, a
 * labelled fact sheet ("fitxa tècnica"), the concept text, then the long
 * free-canvas sequence of images. The layout editor loads here in dev.
 */
import { fade } from 'astro:transitions';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ProjectCanvas from './ProjectCanvas.astro';
import CanvasEditor from './CanvasEditor.astro';
import PlanViewer from './PlanViewer.astro';
import ZoomBar from './ZoomBar.astro';
import { t, type Lang } from '../i18n/ui';
import { site } from '../data/site';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const path = `projects/${project.slug}/`;
const indexHref = lang === 'en' ? '/' : `/${lang}/`;

/** The site owner's name as written in credits — rendered bold so it stands out. */
const ME = 'Àlex Santaeulàlia';

const fitxa = [
  { label: t(lang, 'fitxa_program'), value: project.type[lang] },
  { label: t(lang, 'fitxa_location'), value: project.location[lang] },
  { label: t(lang, 'fitxa_year'), value: project.year },
  { label: t(lang, 'fitxa_studio'), value: project.studio?.[lang] ?? '' },
].filter((f) => f.value);

/** Structured data so the project shows up properly in search results. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title[lang],
  description: project.concept[lang],
  dateCreated: project.year,
  inLanguage: lang,
  creator: { '@type': 'Person', name: site.name },
  image: new URL(`/og/${project.slug}.png`, Astro.site).href,
};
---

<BaseLayout
  lang={lang}
  path={path}
  title={`${site.name} — ${project.title[lang]}`}
  description={project.concept[lang]}
  ogImage={`/og/${project.slug}.png`}
  schema={schema}
>
  <SiteHeader lang={lang} path={path} active="work" />

  <main id="main">
    <div class="container">
      <ZoomBar lang={lang} />

      <header class="pj">
        <h1
          class="pj__title"
          transition:name={`title-${project.slug}`}
          transition:animate={fade({ duration: 650 })}
        >
          {project.title[lang]}
        </h1>

        {
          fitxa.length > 0 && (
            <dl class="pj__fitxa">
              {fitxa.map((f) => (
                <div class="pj__row">
                  <dt>{f.label}:</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {project.concept[lang] && <p class="pj__concept">{project.concept[lang]}</p>}
      </header>

      <ProjectCanvas slug={project.slug} title={project.title[lang]} lang={lang} cover={project.cover} />

      {
        project.credits && project.credits.length > 0 && (
          <footer class="pj-credits">
            <h2 class="pj-credits__title">{t(lang, 'credits')}</h2>
            <dl class="pj__fitxa">
              {project.credits.map((c) => (
                <div class="pj__row">
                  <dt>{c.label[lang]}:</dt>
                  <dd>
                    {c.names.map((n, i) => (
                      <>
                        {i > 0 && ', '}
                        {n === ME ? <strong>{n}</strong> : n}
                      </>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </footer>
        )
      }

      <a class="pj-back" href={indexHref}>← {t(lang, 'back_to_index')}</a>
    </div>
  </main>

  <SiteFooter />

  <PlanViewer lang={lang} />

  {import.meta.env.DEV && <CanvasEditor />}
</BaseLayout>

<style>
  .pj {
    max-width: var(--measure);
    margin-bottom: 3rem;
  }

  .pj__title {
    font-size: var(--fs-l);
    font-weight: 500;
    margin-bottom: 1.1rem;
  }

  .pj__fitxa {
    font-size: var(--fs-s);
    margin-bottom: 1.4rem;
  }

  .pj__row {
    display: flex;
    gap: 0.35rem;
  }

  .pj__row dt {
    color: var(--grey);
  }

  .pj__row dd {
    margin: 0;
  }

  .pj__concept {
    font-size: var(--fs-m);
    color: var(--ink-soft);
  }

  /* Credits: a quiet block after the canvas, same voice as the fitxa. */
  .pj-credits {
    max-width: var(--measure);
    margin-top: 3rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline, #e3e3e0);
  }

  .pj-credits__title {
    font-size: var(--fs-s);
    font-weight: 500;
    margin-bottom: 0.6rem;
  }

  /* The way back home from the bottom of a long canvas. */
  .pj-back {
    display: inline-block;
    margin-top: 2.4rem;
    font-size: var(--fs-s);
    color: var(--grey);
  }

  .pj-back:hover {
    color: var(--ink);
  }
</style>
