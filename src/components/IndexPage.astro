---
/**
 * The homepage IS the project index (as on the reference sites): a quiet
 * 3-column grid of thumbnails with the title and a grey meta line below each.
 *
 * A cover keeps the framing it was given on the project's canvas (rotation,
 * trim, focal point, zoom) — the shared frame engine just refits it to the
 * card's shape. Covers are shown in black & white so the index reads as one
 * balanced set.
 */
import { Image } from 'astro:assets';
import { fade } from 'astro:transitions';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { coverFor } from '../data/layout';
import { frameGeometry, srcStyle, imgStyle, normRot } from '../data/frame';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** Every card is the same shape, so the grid reads as a set — except the
 * first project, which is featured: full row, panoramic frame. */
const CARD_ASPECT = 3 / 2;
const FEATURED_ASPECT = 12 / 5;
const candidates = [400, 700, 1000, 1400, 2000];

/** Where a work comes from, as a terse corner tag: the studio number when
 * there is one (TAP VI … TAP I), RAP for the drawing course, UPC for the
 * research. */
const tagFor = (p: (typeof projects)[number]): string => {
  const studio = p.type.en.match(/studio\s+([IVX]+)/i);
  if (studio) return `TAP ${studio[1]}`;
  return p.slug === 'rap' ? 'RAP' : 'UPC';
};

const cards = projects.map((p, i) => {
  const cover = coverFor(p.slug, p.cover);
  const featured = i === 0;
  let crop = cover?.crop;
  // The featured frame is panoramic: a cover that reads portrait on the canvas
  // is laid on its side here so it fills horizontally (the canvas keeps its
  // own orientation — this quarter turn exists only on the index).
  if (cover && crop && featured && frameGeometry(cover.na, { ...crop, aspect: null }).aspect < 1) {
    crop = { ...crop, rot: normRot((crop.rot ?? 0) + 90) };
  }
  return {
    p,
    cover,
    featured,
    // Same crop, refitted to the card: rotation and trim are preserved.
    g: cover
      ? frameGeometry(cover.na, { ...crop, aspect: featured ? FEATURED_ASPECT : CARD_ASPECT })
      : null,
  };
});
---

<BaseLayout lang={lang} path="">
  <SiteHeader lang={lang} path="" active="work" />

  <main id="main" class="container">
    <h1 class="visually-hidden">{site.name} — portfolio</h1>
    <ul class="grid">
      {
        cards.map(({ p, cover, g, featured }) => (
          <li class:list={{ feat: featured }}>
            <a class="card" href={`${lang === 'en' ? '' : `/${lang}`}/projects/${p.slug}/`}>
              <span
                class="card__frame"
                transition:name={`cover-${p.slug}`}
                transition:animate={fade({ duration: 650 })}
              >
                {cover && g && (
                  <span class="card__src" style={srcStyle(g)}>
                    <Image
                      src={cover.src}
                      alt={p.title[lang]}
                      width={Math.min(featured ? 2000 : 1400, cover.src.width)}
                      widths={candidates.filter((w) => w <= cover.src.width)}
                      sizes={featured ? '92vw' : '(min-width: 60rem) 30vw, (min-width: 40rem) 45vw, 100vw'}
                      loading={featured ? 'eager' : 'lazy'}
                      style={imgStyle(g)}
                    />
                  </span>
                )}
              </span>
              <span class="card__meta" aria-hidden="true">
                <span class="card__meta-title">{p.title[lang]}</span>
                <span class="card__meta-tag">{tagFor(p)}</span>
              </span>
              <span
                class="card__title"
                transition:name={`title-${p.slug}`}
                transition:animate={fade({ duration: 650 })}
              >
                {p.title[lang]}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 2.6rem;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .grid li {
    position: relative;
  }

  /* The hovered work floats over its neighbours while it grows. */
  .grid li:hover {
    z-index: 2;
  }

  .card {
    display: block;
    position: relative;
  }

  /* On hover the work names itself inside the image: title in one corner,
     where it comes from in the other. White pads guarantee contrast on any
     drawing or photograph. Sits outside the morphing frame so the cover
     glide to the project page stays clean. */
  .card__meta {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .card:hover .card__meta,
  .card:focus-visible .card__meta {
    opacity: 1;
  }

  .card__meta-title,
  .card__meta-tag {
    position: absolute;
    font-size: var(--fs-xs);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.92);
    padding: 0.15rem 0.55rem;
    transition: transform 0.6s var(--ease-land);
  }

  .card__meta-title {
    left: 0.55rem;
    bottom: 0.55rem;
    transform: translateY(5px);
  }

  .card__meta-tag {
    right: 0.55rem;
    top: 0.55rem;
    transform: translateY(-5px);
  }

  .card:hover .card__meta-title,
  .card:hover .card__meta-tag,
  .card:focus-visible .card__meta-title,
  .card:focus-visible .card__meta-tag {
    transform: none;
  }

  /* No hover, no overlay: touch screens keep the caption below instead. */
  @media (hover: none), (pointer: coarse) {
    .card__meta {
      display: none;
    }
  }

  .card:hover {
    opacity: 1;
  }

  .card__frame {
    display: block;
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f4f4f2;
    transition: transform 3.2s var(--ease-soft);
  }

  /* On hover the WHOLE framed image zooms as one piece, slowly growing past
     its own margins over the grid — no internal crop, no lean. */
  .card:hover .card__frame,
  .card:focus-visible .card__frame {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card__frame,
    .card:focus-visible .card__frame {
      transform: none;
    }
  }

  /* The trimmed source box: cover-sized then rotated (see data/frame.ts). */
  .card__src {
    display: block;
    position: absolute;
    overflow: hidden;
    transform-origin: center;
  }

  /* Sized/offset by the frame engine; max-width must be released because the
     global reset caps images at 100%. Colour returns on hover. */
  /* .grid prefix: this must out-rank the global lazy-image fade rule, which
     also sets `transition` — without it, lazy cards would lose their colour
     transition (the eager featured card was the only one unaffected).
     Opacity is carried along so the load fade still happens here too. */
  .grid .card__frame :global(img) {
    position: absolute;
    display: block;
    max-width: none;
    filter: grayscale(1);
    transition:
      opacity 0.6s var(--ease-soft),
      filter 0.5s ease;
  }

  /* Colour returns while the frame grows. */
  .card:hover .card__frame :global(img),
  .card:focus-visible .card__frame :global(img) {
    filter: grayscale(0);
  }

  /* Quiet caption: small and grey, taking ink only when the card is hovered. */
  .card__title {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--grey);
    transition: color 0.25s ease;
  }

  .card:hover .card__title {
    color: var(--ink);
  }

  /* On desktop the grid is silent: no captions — the trailing black dot
     carries each project's title when it passes over. Touch screens keep
     the captions (they have no pointer to name things with). */
  @media (hover: hover) and (pointer: fine) {
    .card__title {
      display: none;
    }
  }

  /* Featured project: full row, panoramic frame, slightly larger title. */
  .feat {
    grid-column: 1 / -1;
  }

  .feat .card__frame {
    aspect-ratio: 12 / 5;
  }

  .feat .card__title {
    font-size: var(--fs-s);
    margin-top: 0.6rem;
  }
</style>

