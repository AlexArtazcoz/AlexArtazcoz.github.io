---
/**
 * The homepage IS the project index (as on the reference sites): a quiet
 * 3-column grid of thumbnails with the title and a grey meta line below each.
 *
 * A cover keeps the framing it was given on the project's canvas (rotation,
 * trim, focal point, zoom) — the shared frame engine just refits it to the
 * card's shape. Covers are shown in black & white so the index reads as one
 * balanced set.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { projects } from '../data/projects';
import { coverFor } from '../data/layout';
import { frameGeometry, srcStyle, imgStyle } from '../data/frame';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** Every card is the same shape, so the grid reads as a set. */
const CARD_ASPECT = 3 / 2;
const candidates = [400, 700, 1000, 1400];

const cards = projects.map((p) => {
  const cover = coverFor(p.slug, p.cover);
  return {
    p,
    cover,
    // Same crop, refitted to the card: rotation and trim are preserved.
    g: cover ? frameGeometry(cover.na, { ...cover.crop, aspect: CARD_ASPECT }) : null,
  };
});
---

<BaseLayout lang={lang} path="">
  <SiteHeader lang={lang} path="" active="work" />

  <main id="main" class="container">
    <ul class="grid">
      {
        cards.map(({ p, cover, g }) => (
          <li>
            <a class="card" href={`${lang === 'en' ? '' : `/${lang}`}/projects/${p.slug}/`}>
              <span class="card__frame">
                {cover && g && (
                  <span class="card__src" style={srcStyle(g)}>
                    <Image
                      src={cover.src}
                      alt={p.title[lang]}
                      widths={candidates.filter((w) => w <= cover.src.width)}
                      sizes="(min-width: 60rem) 30vw, (min-width: 40rem) 45vw, 100vw"
                      loading="lazy"
                      style={imgStyle(g)}
                    />
                  </span>
                )}
              </span>
              <span class="card__title">{p.title[lang]}</span>
              <span class="card__meta">{[p.type[lang], p.year].filter(Boolean).join(', ')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 2.6rem;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .card {
    display: block;
  }

  .card:hover {
    opacity: 1;
  }

  .card__frame {
    display: block;
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f4f4f2;
  }

  /* The trimmed source box: cover-sized then rotated (see data/frame.ts). */
  .card__src {
    display: block;
    position: absolute;
    overflow: hidden;
    transform-origin: center;
  }

  /* Sized/offset by the frame engine; max-width must be released because the
     global reset caps images at 100%. Colour returns on hover. */
  .card__frame :global(img) {
    position: absolute;
    display: block;
    max-width: none;
    filter: grayscale(1);
    transition: filter 0.25s ease;
  }

  .card:hover .card__frame :global(img) {
    filter: grayscale(0);
  }

  .card__title {
    display: block;
    margin-top: 0.55rem;
    font-size: var(--fs-s);
    color: var(--ink);
  }

  .card__meta {
    display: block;
    font-size: var(--fs-s);
    color: var(--grey);
  }
</style>
