---
/**
 * A quiet zoom bar shown once, at the top of a project page: − / % / +.
 * It scales the whole page (CSS zoom on <body>) for readers who find the
 * default too close, and remembers the choice in localStorage. It scrolls
 * away with the content — deliberately not sticky.
 */
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="zoom" data-zoombar>
  <button type="button" data-z="out" aria-label={t(lang, 'zoom_out')} title={t(lang, 'zoom_out')}>−</button>
  <button
    type="button"
    class="zoom__val"
    data-z="reset"
    aria-label={t(lang, 'zoom_reset')}
    title={t(lang, 'zoom_reset')}>100%</button
  >
  <button type="button" data-z="in" aria-label={t(lang, 'zoom_in')} title={t(lang, 'zoom_in')}>+</button>
</div>

<style>
  .zoom {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 1.1rem;
    color: var(--grey);
    font-size: var(--fs-s);
  }

  .zoom button {
    background: none;
    border: none;
    padding: 0;
    width: 1.6rem;
    height: 1.6rem;
    font: inherit;
    color: inherit;
    cursor: pointer;
    line-height: 1;
  }

  .zoom button:hover {
    color: var(--ink);
  }

  .zoom__val {
    width: auto;
    min-width: 2.6rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  // Idempotent init: runs on the initial load and again after every
  // ClientRouter navigation (the swapped-in bar and body start unbound).
  const initZoomBar = () => {
    const KEY = 'aa-zoom';
    const MIN = 0.6;
    const MAX = 1.2;
    const bar = document.querySelector('[data-zoombar]') as HTMLElement | null;
    if (!bar || bar.dataset.bound) return;
    bar.dataset.bound = '1';

    const val = bar.querySelector('.zoom__val') as HTMLElement;
    const clamp = (v: number) => Math.min(MAX, Math.max(MIN, Math.round(v * 10) / 10));
    let zoom = clamp(parseFloat(localStorage.getItem(KEY) ?? '1') || 1);

    const apply = () => {
      // 1 means untouched: remove the property so the page is exactly default.
      if (zoom === 1) document.body.style.removeProperty('zoom');
      else document.body.style.setProperty('zoom', String(zoom));
      val.textContent = Math.round(zoom * 100) + '%';
      localStorage.setItem(KEY, String(zoom));
    };

    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      const step = b.dataset.z === 'in' ? 0.1 : b.dataset.z === 'out' ? -0.1 : NaN;
      zoom = Number.isNaN(step) ? 1 : clamp(zoom + step);
      apply();
    });

    apply();
  };
  initZoomBar();
  document.addEventListener('astro:page-load', initZoomBar);
</script>
