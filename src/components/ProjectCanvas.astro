---
/**
 * Renders a project's free-canvas composition. The stage keeps a fixed
 * aspect-ratio (canvas width : height) so the whole arrangement scales down
 * intact on smaller screens. Each image is absolutely positioned in percentages
 * of the stage, and framed non-destructively (trim → rotate → shape → zoom →
 * pan) by the shared geometry in src/data/frame.ts.
 */
import { Image } from 'astro:assets';
import { fade } from 'astro:transitions';
import { renderCanvas, CANVAS_W } from '../data/layout';
import { frameGeometry, srcStyle, imgStyle, viewerFrame } from '../data/frame';
import { t, type Lang } from '../i18n/ui';

interface Props {
  slug: string;
  title: string;
  lang: Lang;
  /** Explicit cover fallback (Project.cover) so the index card can morph into
   * the same image here via a shared view-transition name. */
  cover?: string;
}

const { slug, title, lang, cover } = Astro.props;
const canvas = renderCanvas(slug);
// Large steps included so retina screens get crisp linework on the canvas.
const candidates = [400, 800, 1200, 1600, 2000, 2600, 3200];

// The canvas item that acts as the project's cover (same resolution order as
// coverFor in data/layout.ts) — it morphs from the index card on navigation.
const coverName = canvas.cover ?? cover ?? canvas.items[0]?.img;
let coverUsed = false;

// Compact model consumed by the (dev-only) layout editor.
const editorModel = {
  h: canvas.h,
  cover: canvas.cover ?? null,
  picks: canvas.picks ?? null,
  items: canvas.items.map((it) => ({
    img: it.img,
    x: it.x,
    y: it.y,
    w: it.w,
    z: it.z,
    crop: it.crop,
    na: Math.round(it.na * 10000) / 10000,
  })),
};
---

<div class="canvas" data-canvas={slug} style={`aspect-ratio: ${CANVAS_W} / ${canvas.h};`}>
  {
    canvas.items.map((it) => {
      const left = (it.x / CANVAS_W) * 100;
      const top = (it.y / canvas.h) * 100;
      const width = (it.w / CANVAS_W) * 100;
      const widths = candidates.filter((w) => w <= it.src.width);
      const g = frameGeometry(it.na, it.crop);
      const isCover = !coverUsed && it.img === coverName && (coverUsed = true);
      // The viewer reproduces this frame exactly: trim as a pixel clip, the
      // quarter-turn, and the visible window as its opening viewport.
      const vf = viewerFrame(it.na, it.crop);
      const attrs = {
        class: 'canvas__item',
        'data-img': it.img,
        'data-full': it.src.src,
        'data-frame': JSON.stringify({
          rot: vf.rot,
          clip: [
            Math.round(vf.clip[0] * it.src.width),
            Math.round(vf.clip[1] * it.src.height),
            Math.round(vf.clip[2] * it.src.width),
            Math.round(vf.clip[3] * it.src.height),
          ],
          view: vf.view,
        }),
        role: 'button',
        tabindex: '0',
        'aria-label': `${title} — ${t(lang, 'viewer_open')}`,
        style: `left:${left}%; top:${top}%; width:${width}%; z-index:${it.z};`,
      };
      const inner = (
        <div class="canvas__frame" style={`aspect-ratio:${g.aspect};`}>
          <div class="canvas__src" style={srcStyle(g)}>
            <Image
              src={it.src}
              alt={title}
              widths={widths.length ? widths : [it.src.width]}
              sizes={`${Math.max(10, Math.round(width))}vw`}
              quality={90}
              loading="lazy"
              style={imgStyle(g)}
            />
          </div>
        </div>
      );
      // Only the cover carries the shared view-transition name (an undefined
      // transition:name would still create a per-item transition group).
      return isCover ? (
        <figure {...attrs} transition:name={`cover-${slug}`} transition:animate={fade({ duration: 650 })}>
          {inner}
        </figure>
      ) : (
        <figure {...attrs}>{inner}</figure>
      );
    })
  }
  {
    import.meta.env.DEV && (
      <script type="application/json" class="canvas-model" set:html={JSON.stringify(editorModel)} />
    )
  }
</div>

<style>
  .canvas {
    position: relative;
    width: 100%;
  }

  .canvas__item {
    position: absolute;
    margin: 0;
  }

  .canvas__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f4f4f2;
  }

  /* The trimmed source box: cover-sized then rotated (see data/frame.ts). */
  .canvas__src {
    position: absolute;
    overflow: hidden;
    transform-origin: center;
  }

  /* Sized/offset so the trimmed rectangle exactly fills .canvas__src.
     max-width must be released: the global reset caps images at 100%. */
  .canvas__src :global(img) {
    position: absolute;
    display: block;
    max-width: none;
  }
</style>
