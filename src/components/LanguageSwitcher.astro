---
/**
 * CAT ENG ESP switch (harquitectes-style). Links go to the same page in each
 * language, so switching never loses your place.
 */
import { languages, localeName, localeShort, t, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Locale-relative path of the current page. */
  path?: string;
}

const { lang, path = '' } = Astro.props;
---

<nav class="langs" aria-label={t(lang, 'lang_label')}>
  {
    languages.map((l) => (
      <a
        href={localePath(l, path)}
        hreflang={l}
        lang={l}
        aria-label={localeName[l]}
        aria-current={l === lang ? 'true' : undefined}
      >
        <span class="langs__code">{l.toUpperCase()}</span>
        <span class="langs__full">{localeShort[l]}</span>
      </a>
    ))
  }
</nav>

<style>
  .langs {
    display: flex;
    gap: 0.6rem;
    font-size: var(--fs-s);
  }

  /* Phones get EN CA ES, wider screens the full ENG CAT ESP. Either way each
     link is announced by its aria-label, so the visible text is free to shrink. */
  .langs__full {
    display: none;
  }

  @media (min-width: 40rem) {
    .langs {
      gap: 0.75rem;
    }

    .langs__code {
      display: none;
    }

    .langs__full {
      display: inline;
    }
  }

  .langs a {
    color: var(--grey);
  }

  .langs a:hover {
    color: var(--ink);
    opacity: 1;
  }

  .langs a[aria-current='true'] {
    color: var(--ink);
  }
</style>
